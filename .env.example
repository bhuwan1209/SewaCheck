# Copy to .env.local and fill in from Supabase > Project Settings > API.
# NEVER commit .env.local (it is git-ignored).

# Safe for the browser (protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret used to salt anti-spam hashes. Any long random string.
# Do NOT prefix with NEXT_PUBLIC_. The Supabase service-role key is NOT used by this app.
SPAM_HASH_SALT=
